Bootstrap: docker
From: ubuntu:22.04

%labels
    Author WorkshopPresenter
    Description OpenMPI and mpi4py Singularity Stack

%environment
    export LC_ALL=C.UTF-8
    export LANG=C.UTF-8
    export PATH=/opt/openmpi/bin:$PATH
    export LD_LIBRARY_PATH=/opt/openmpi/lib:$LD_LIBRARY_PATH

%post
    export DEBIAN_FRONTEND=noninteractive
    apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        gfortran \
        wget \
        curl \
        ca-certificates \
        python3 \
        python3-pip \
        python3-dev \
        libibverbs-dev \
        libnl-3-200 \
        libnl-route-3-200 \
        libnuma1 \
        git \
        && rm -rf /var/lib/apt/lists/*

    # 1. Install OpenMPI from source (matches typical cluster OpenMPI 4.1.x)
    cd /tmp
    wget https://download.open-mpi.org/release/open-mpi/v4.1/openmpi-4.1.6.tar.gz
    tar -xzf openmpi-4.1.6.tar.gz
    cd openmpi-4.1.6
    ./configure --prefix=/opt/openmpi \
                --enable-mpi-cxx \
                --with-pmi \
                --with-pmix=internal \
                --without-verbs
    make -j$(nproc)
    make install
    cd / && rm -rf /tmp/openmpi*

    # 2. Configure Environment for Python bindings
    export PATH=/opt/openmpi/bin:$PATH
    export LD_LIBRARY_PATH=/opt/openmpi/lib:$LD_LIBRARY_PATH

    # 3. Install Python Dependencies
    python3 -m pip install --no-cache-dir --upgrade pip setuptools wheel
    python3 -m pip install --no-cache-dir numpy
    MPICC=/opt/openmpi/bin/mpicc python3 -m pip install --no-cache-dir mpi4py

%runscript
    exec "$@"
